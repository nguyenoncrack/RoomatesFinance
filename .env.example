# Leave these empty to run in demo mode (seeded household stored in your browser).
# Fill both in to switch the app to Supabase auth + Postgres.
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" / publishable key. Never put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in shows on the login page whenever Supabase is configured (enable the Google provider in Supabase).
# Set to false to hide it.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Force demo mode even when Supabase keys are present.
NEXT_PUBLIC_DEMO_MODE=false

# The request guard (per-IP rate limiting in src/proxy.ts) is on by default. Set to true to switch it off,
# for example in automated tests. See SECURITY.md.
# RATE_LIMIT_DISABLED=false

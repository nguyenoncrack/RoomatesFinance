# Leave these empty to run in demo mode (seeded household stored in your browser).
# Fill both in to switch the app to Supabase auth + Postgres.
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" / publishable key. Never put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Show "Continue with Google" on the sign-in page (enable the Google provider in Supabase first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Force demo mode even when Supabase keys are present.
NEXT_PUBLIC_DEMO_MODE=false
